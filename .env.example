# From Storyblok: Organization (or Partner Portal) → Extensions → your Space Plugin
STORYBLOK_PLUGIN_CLIENT_IDENTIFIER=""
STORYBLOK_PLUGIN_CLIENT_SECRET=""
# The plugin's slug (Extensions -> your plugin), used to find its space-level settings
STORYBLOK_SPACE_PLUGIN_SLUG="your-org@label-translation-ui"

# The public HTTPS URL that Storyblok loads the plugin from (an ngrok tunnel in development).
# Set the same URL as "Index to your page", and {URL}/api/connect/callback as "Redirection endpoint".
STORYBLOK_PLUGIN_BASE_URL="https://your-subdomain.ngrok-free.app"

# Optional: a public CDN token for the dev-only /preview route (read-only data, fake saves)
STORYBLOK_PREVIEW_TOKEN=""

# AI translation (Claude Haiku 5.5 usually enough). From https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=""
